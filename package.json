{
  "name": "official-modules",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build --filter='./packages/*'",
    "dev": "yarn sandbox:dev",
    "typecheck": "turbo run typecheck --filter='./packages/*'",
    "test": "turbo run test --filter='./packages/*'",
    "sandbox:generate": "yarn workspace sandbox generate",
    "sandbox:dev": "yarn workspace sandbox dev",
    "sandbox:build": "yarn workspace sandbox build",
    "sandbox:mercato": "yarn workspace sandbox mercato"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.25.0",
    "glob": "^13.0.6",
    "tsx": "^4.21.0",
    "turbo": "^2.3.3",
    "typescript": "^5.9.3"
  }
}
