{
  "name": "@open-mercato/enrichment-treg",
  "version": "0.1.0",
  "type": "module",
  "description": "Enrich CRM people and companies with profile data fetched through treg.to.",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "watch": "node watch.mjs",
    "test": "jest --config jest.config.cjs",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*.ts": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "./*.tsx": {
      "types": "./src/*.tsx",
      "default": "./dist/*.js"
    },
    "./*.json": "./src/*.json",
    "./*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx"
      ],
      "default": "./dist/*.js"
    },
    "./*/*.json": "./src/*/*.json",
    "./*/*": {
      "types": [
        "./src/*/*.ts",
        "./src/*/*.tsx"
      ],
      "default": "./dist/*/*.js"
    },
    "./*/*/*.json": "./src/*/*/*.json",
    "./*/*/*": {
      "types": [
        "./src/*/*/*.ts",
        "./src/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*.js"
    },
    "./*/*/*/*.json": "./src/*/*/*/*.json",
    "./*/*/*/*": {
      "types": [
        "./src/*/*/*/*.ts",
        "./src/*/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*/*.js"
    }
  },
  "peerDependencies": {
    "@mikro-orm/core": "^7.1.14",
    "@mikro-orm/decorators": "^7.1.14",
    "@mikro-orm/postgresql": "^7.1.14",
    "@open-mercato/core": "^0.8.0",
    "@open-mercato/queue": "^0.8.0",
    "@open-mercato/shared": "^0.8.0",
    "@open-mercato/ui": "^0.8.0",
    "awilix": "^13.0.0",
    "lucide-react": "^1.0.0",
    "next": ">=15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@mikro-orm/core": "^7.1.14",
    "@mikro-orm/decorators": "^7.1.14",
    "@mikro-orm/postgresql": "^7.1.14",
    "@open-mercato/core": "0.8.1-develop.7297.1.67605e74f9",
    "@open-mercato/events": "0.8.1-develop.7297.1.67605e74f9",
    "@open-mercato/queue": "0.8.1-develop.7297.1.67605e74f9",
    "@open-mercato/shared": "0.8.1-develop.7297.1.67605e74f9",
    "@open-mercato/ui": "0.8.1-develop.7297.1.67605e74f9",
    "@types/jest": "^30.0.0",
    "esbuild": "^0.25.0",
    "glob": "^13.0.6",
    "jest": "^30.2.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
